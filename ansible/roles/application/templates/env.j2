# Human Firewall Production Environment
FLASK_APP=run.py
FLASK_ENV={{ flask_env | default('production') }}
SECRET_KEY={{ app_secret_key | default('96699e3db818eb8a7f75382cf68d3ef6eec40c507e0aab2a7c744773e0e4ecd3') }}
PORT={{ app_port | default(5000) }}

# Database URL
DATABASE_URL=postgresql+psycopg://{{ db_user }}:{{ db_password }}@{{ hostvars[groups['dbservers'][0]]['ansible_host'] }}:{{ db_port }}/{{ db_name }}

# Redis Distributed Cache & Rate Limiting
REDIS_URL=redis://{{ hostvars[groups['dbservers'][0]]['ansible_host'] }}:{{ redis_port }}/0
RATELIMIT_STORAGE_URI=redis://{{ hostvars[groups['dbservers'][0]]['ansible_host'] }}:{{ redis_port }}/1

SESSION_COOKIE_SECURE=false
REMEMBER_COOKIE_SECURE=false
NEWS_INGEST_ENABLED=true

