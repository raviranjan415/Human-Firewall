# ---------------------------------------------------------------------------
# Human Firewall — environment configuration template
# Copy this file to `.env` and adjust the values for your environment.
# NEVER commit the real `.env` file or production secrets.
# ---------------------------------------------------------------------------

# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"

# Database
# Local development:
DATABASE_URL=sqlite:///cyberquest.db
# Production (PostgreSQL with PgBouncer connection pooler):
# DATABASE_URL=postgresql+psycopg://human_firewall_user:secure_password@localhost:5432/human_firewall_prod

# Session / cookies
SESSION_COOKIE_SECURE=false
REMEMBER_COOKIE_SECURE=false
PERMANENT_SESSION_LIFETIME_MINUTES=120

# Bootstrap administrator account (created by `flask seed` on first run).
# Change this password immediately in any real deployment, and delete these
# variables in production after the first initialization.
ADMIN_USERNAME=admin
ADMIN_EMAIL=raviranjanyadav963625@gmail.com
ADMIN_PASSWORD=@Admin150305

# Demo learner / instructor accounts (development only — disabled in production)
CREATE_DEMO_ACCOUNTS=true
DEMO_PASSWORD=Demo@12345

# Gamification defaults (overridable at runtime by an administrator)
XP_VIDEO_LESSON=20
XP_COMIC=15
XP_LAB_BASIC=30
XP_LAB_INTERMEDIATE=50
XP_LAB_ADVANCED=75
XP_LAB_CAPSTONE=150
XP_DAILY_CHALLENGE=25
XP_PERFECT_BONUS=10
CERTIFICATE_PASS_SCORE=80

# Daily cyber-news ingestion
NEWS_INGEST_ENABLED=true
NEWS_INGEST_INTERVAL_HOURS=6
NEWS_MAX_ITEMS_PER_SOURCE=15

# Rate limiting for sensitive endpoints
RATELIMIT_STORAGE_URI=memory://
LOGIN_RATE_LIMIT=10 per minute
